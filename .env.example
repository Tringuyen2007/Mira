# Copy to .env (never commit .env). Placeholders only.

# --- core ---
MIRA_API_TOKEN=change-me-long-random-token
MIRA_SOURCE=mock                 # mock | mock:fall | replay:data/recordings/<file>.jsonl | live
ENGINE_MODE=thread               # thread | process
MOCK_PATIENT_ID=maya
MOCK_FALL_RESPONDS_AT=           # seconds after the scripted fall; empty = never responds
DEMO_TOOLS_ENABLED=0             # 1 enables POST /demo/trigger_fall (rehearsals only)

# --- database (unset TIGER_DSN = run without a database) ---
# Tiger: postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
# Local fallback (make db-local): postgresql://postgres:mira@localhost:55432/mira
TIGER_DSN=
# Same host/db as TIGER_DSN, user copilot_ro (read-only role created by roles.sql)
COPILOT_DSN=
COPILOT_RO_PASSWORD=             # copilot_ro password used by roles.sql / make db-setup (or put it in COPILOT_DSN)
DB_DISABLED=0

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODE=fake                 # fake | live | replay (saved answers in data/ai_cache/)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_SMART_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_DISABLED=0                # 1 = every caller uses its fallback
GEMINI_DAILY_LIMIT=1000          # requests/day for models not in the built-in free-tier table
GEMINI_DAILY_LIMITS=             # overrides, e.g. gemini-3.8-flash=20,gemini-3.5-flash-lite=500

# --- ElevenLabs ---
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=                 # e.g. the "Sarah" voice id
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_DISABLED=0                # 1 = captions + already-recorded MP3s only

# --- Retell ---
RETELL_API_KEY=
RETELL_FROM_NUMBER=              # E.164, e.g. +1713XXXXXXX
RETELL_AGENT_ID=                 # printed by: python -m server.notify.retell_setup --apply
RETELL_AGENT_VERSION=            # published version, printed by the same command (re-copy after each --apply)
CALLS_DISABLED=1                 # 1 = log-only call simulator (no real calls, no Retell credits)
SIM_CALL_DURATION_S=45           # simulated call length when CALLS_DISABLED=1
CHECKIN_TIMEOUT_S=30             # 15 for demos
DEMO_EMERGENCY_PHONE=            # E.164
DEMO_THERAPIST_PHONE=            # E.164
DEMO_PATIENT_PHONE=              # E.164, Maya's phone in the default profile ({{patient_phone}} on the call)

# --- agents / demo ---
INSIGHT_ENABLED=1                # Insight agent every INSIGHT_INTERVAL_S (needs TIGER_DSN + COPILOT_DSN)
INSIGHT_DELAY_S=120              # first run after startup
INSIGHT_INTERVAL_S=900
DATA_GUARD_ENABLED=1             # Data Guard checks 1-4 + archive every DATA_GUARD_INTERVAL_S (needs TIGER_DSN)
DATA_GUARD_DELAY_S=300           # 5 min after startup: normally just after a refresh-policy run
DATA_GUARD_INTERVAL_S=900
COPILOT_CACHED_DEMO=0
PUBLIC_WEBHOOK_HOST=             # tunnel host name, e.g. mira-xyz.trycloudflare.com

# --- paths ---
LOG_DIR=logs
DATA_DIR=data
TZ_NAME=America/Chicago
