# Copy to .env (never commit .env). Placeholders only.

# --- core ---
# Required. The server refuses this placeholder and any token under 24 characters. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MIRA_API_TOKEN=change-me-long-random-token
# Optional: least-privilege token for the Mira LCD kiosk (/device/). It can only open /ws/live and /ws/events
# and only send device_health. Must be >= 24 chars and differ from MIRA_API_TOKEN. Open the kiosk once with
# http://<server>:8000/device/#token=<this token>
MIRA_DEVICE_TOKEN=
MIRA_VISION_TOKEN=
# Live camera playback (MediaMTX WHEP); leave blank until the media relay is deployed.
MIRA_WHEP_URL=
LCD_LINK_KEY=                     # optional: GET /lcd/<key> opens the LCD kiosk already paired (share that link)
MIRA_SOURCE=mock                 # mock | mock:fall | replay:data/recordings/<file>.jsonl | live
ENGINE_MODE=thread               # thread | process
MOCK_PATIENT_ID=maya
MOCK_FALL_RESPONDS_AT=           # seconds after the scripted fall; empty = never responds
DEMO_TOOLS_ENABLED=0             # 1 enables POST /demo/trigger_fall (rehearsals only)
MOCK_LOOP=0                      # 1 = the mock squat program repeats forever (pre-Plan-2 behaviour); implies no auto-stop/auto-restart
MOCK_AUTO_RESTART_S=60           # mock mode: start the next demo session this long after one ends (0 = off)
AUTO_STOP_AFTER_LAST_SET=1       # end the session when set == sets_target (for engines without `stopped`)
ANALYST_DELAY_S=2                # SessionAnalyst waits this long after a session ends for rep writes to land

# --- database (unset TIGER_DSN = run without a database) ---
# Tiger: postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
# Local fallback (make db-local): postgresql://postgres:mira@localhost:55432/mira
TIGER_DSN=
# Same host/db as TIGER_DSN, user copilot_ro (read-only role created by roles.sql)
# Local: postgresql://copilot_ro:mira-local-ro@localhost:55432/mira (make db-local and the tests use mira-local-ro)
COPILOT_DSN=
COPILOT_RO_PASSWORD=             # Tiger copilot_ro password for make db-setup (or put it in COPILOT_DSN); not used locally
DB_DISABLED=0
# Apply server/db/migrations/*.sql at start (idempotent). 0 to manage the schema by hand.
DB_AUTO_MIGRATE=1
PAIRING_DEMO_CODE=K7P4M2          # seeded demo therapist code (pairs the phone to Maya)
PAIRING_DEMO_CODE_REUSABLE=1      # 1 = the demo code never gets marked used, so the demo phone can re-pair
PAIRING_REUSABLE_UPDATES_PROFILE=1  # 0 on a public server: locks demo-code phones (no profile/contact edits,
                                    # no DELETE /me, no test calls); also rotate PAIRING_DEMO_CODE there

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_API_KEYS=                  # optional extra keys (comma-separated), used in turn when one hits its daily quota
GEMINI_MODE=fake                 # fake | live | replay (saved answers in data/ai_cache/)
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_SMART=gemini-3.8-flash
GEMINI_SMART_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low        # minimal | low | medium | high | off; off = no thinking_config sent
GEMINI_DISABLED=0                # 1 = every caller uses its fallback
GEMINI_DAILY_LIMIT=1000          # requests/day for models not in the built-in free-tier table
GEMINI_DAILY_LIMITS=             # overrides, e.g. gemini-3.8-flash=20,gemini-3.5-flash-lite=500

# --- ElevenLabs ---
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=                 # e.g. the "Sarah" voice id
ELEVEN_MODEL=eleven_flash_v2_5
ELEVEN_DISABLED=0                # 1 = captions + already-recorded MP3s only

# --- Retell ---
RETELL_API_KEY=
RETELL_FROM_NUMBER=              # E.164, e.g. +1713XXXXXXX
RETELL_AGENT_ID=                 # printed by: python -m server.notify.retell_setup --apply
RETELL_AGENT_VERSION=            # published version, printed by the same command (re-copy after each --apply)
RETELL_BACKUP_AGENT_ID=          # non-Gemini fallback agent, printed by the same command
RETELL_BACKUP_AGENT_VERSION=
CALLS_DISABLED=1                 # 1 = log-only call simulator (no real calls, no Retell credits)
ALLOW_TEST_CALLS=0               # 1 = POST /me/test-alert may place a real call (also needs CALLS_DISABLED=0)
SIM_CALL_DURATION_S=45           # simulated call length when CALLS_DISABLED=1
CHECKIN_TIMEOUT_S=30             # 15 for demos
DEMO_CONTACT_NAME=Eric
DEMO_EMERGENCY_PHONE=            # E.164
DEMO_THERAPIST_PHONE=            # E.164
DEMO_PATIENT_PHONE=              # E.164, Maya's phone in the default profile ({{patient_phone}} on the call)

# --- agents / demo ---
INSIGHT_ENABLED=1                # Insight agent every INSIGHT_INTERVAL_S (needs TIGER_DSN + COPILOT_DSN)
INSIGHT_DELAY_S=120              # first run after startup
INSIGHT_INTERVAL_S=900
DATA_GUARD_ENABLED=1             # Data Guard checks 1-4 + archive every DATA_GUARD_INTERVAL_S (needs TIGER_DSN + COPILOT_DSN)
DATA_GUARD_DELAY_S=300           # 5 min after startup: normally just after a refresh-policy run
DATA_GUARD_INTERVAL_S=900
COPILOT_CACHED_DEMO=0            # 1 = serve data/copilot_demo.json for the demo question
MIRA_EVAL_DSN=                   # make evals: app DSN (default: local mira database)
MIRA_EVAL_RO_DSN=                # make evals: copilot_ro DSN (default: MIRA_EVAL_DSN as copilot_ro + COPILOT_RO_PASSWORD)
PUBLIC_WEBHOOK_HOST=             # tunnel host name, e.g. mira-xyz.trycloudflare.com
NOTIFY_RESEND_MIN=5              # urgent, unacked dashboard notifications are re-sent every N minutes

# --- paths ---
LOG_DIR=logs
DATA_DIR=data
TZ_NAME=America/Chicago
