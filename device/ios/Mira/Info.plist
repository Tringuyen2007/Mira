<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>UIAppFonts</key>
    <array>
        <string>Fonts/Inter-Light.otf</string>
        <string>Fonts/Inter-Regular.otf</string>
        <string>Fonts/Inter-Medium.otf</string>
        <string>Fonts/Inter-SemiBold.otf</string>
    </array>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Mira connects to the Mira server on your local network for live exercise feedback.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- Demo server is plain HTTP on a public IP (no TLS chosen for the hackathon). Remove when the server gets HTTPS.
             Do NOT add NSAllowsLocalNetworking next to this: on iOS 10+ its presence makes iOS ignore
             NSAllowsArbitraryLoads, and every non-local http:// address fails with "requires a secure connection". -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
